# Local Linux verification for Windows developers.
# Builds, vets, tests, and headless-smokes the Linux binary so you can be sure
# the Linux target works without a Linux machine.
#
#   docker build -f build/Dockerfile.linux-test -t dbd-linux-test .
#   docker run --rm dbd-linux-test
FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libgl1-mesa-dev \
        libgl1-mesa-dri \
        xorg-dev \
        libxkbcommon-dev \
        xvfb \
        xauth \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ENV CGO_ENABLED=1

# Download modules in their own layer, so editing the source reuses it.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Fail the image build early if anything does not compile on Linux. The build
# cache this fills is reused by the tests and the binary build in linux-verify.sh.
RUN go build ./... && go vet ./...

CMD ["bash", "scripts/linux-verify.sh"]
